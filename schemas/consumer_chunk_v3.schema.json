{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consumer_contract_version",
    "identity",
    "kind",
    "phase",
    "part",
    "part_count",
    "fragments"
  ],
  "properties": {
    "consumer_contract_version": {
      "const": "3.0"
    },
    "identity": {
      "$ref": "consumer_manifest_v3.schema.json#/$defs/identity"
    },
    "kind": {
      "enum": [
        "phase",
        "detail",
        "handoff"
      ]
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "part": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "part_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    }
  }
}
